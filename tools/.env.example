# Copy to tools/.env.local (optional — store also set in shopify.app.toml)
#
# Permanent myshopify domain (from Shopify OAuth / Settings → Domains).
# Admin slug "riccis-italian-sausage" ≠ myshopify subdomain.

SHOPIFY_STORE=tiyndf-za

# One-time CLI auth (Node 22):
#   nvm use 22
#   shopify store auth --store tiyndf-za.myshopify.com --scopes read_products,write_products
#
# Then:
#   ./tools/shopify/sync-bundles.sh --ping
#   ./tools/shopify/sync-bundles.sh
